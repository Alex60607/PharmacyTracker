@page
@model LoginModel

@{
ViewData["Title"] = "Вход";
}

<div class="min-h-[calc(100vh-80px)] flex items-center justify-center px-4 py-10"> <div class="w-full max-w-md">

    <!-- Заголовок -->
    <div class="text-center mb-8">
        <div class="mx-auto w-16 h-16 bg-gradient-to-br from-teal-400 to-cyan-500 rounded-2xl flex items-center justify-center shadow-lg shadow-teal-500/30 mb-5">
            <svg class="w-8 h-8 text-white"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a6 6 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A6 6 0 009 10.172V5L8 4z">
                </path>
            </svg>
        </div>

        <h1 class="text-3xl font-bold bg-gradient-to-r from-teal-600 to-cyan-600 bg-clip-text text-transparent">
            Вход в Аптечку
        </h1>

        <p class="mt-2 text-slate-500">
            Войдите, чтобы управлять своими лекарствами
        </p>
    </div>

    <!-- Карточка входа -->
    <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-7 sm:p-8">

        <form id="account" method="post">

            <!-- Общие ошибки -->
            <div asp-validation-summary="ModelOnly"
                 class="mb-5 rounded-xl bg-rose-50 border border-rose-100 px-4 py-3 text-sm text-rose-600"
                 role="alert">
            </div>

            <!-- Email -->
            <div class="mb-5">
                <label asp-for="Input.Email"
                       class="block text-sm font-medium text-slate-600 mb-2">
                    Электронная почта
                </label>

                <div class="relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                        <svg class="w-5 h-5 text-slate-400"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                            </path>
                        </svg>
                    </div>

                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com"
                           class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 placeholder-slate-400 outline-none transition-all focus:bg-white focus:border-teal-400 focus:ring-2 focus:ring-teal-100" />
                </div>

                <span asp-validation-for="Input.Email"
                      class="block mt-1.5 text-sm text-rose-600">
                </span>
            </div>

            <!-- Пароль -->
            <div class="mb-5">
                <label asp-for="Input.Password"
                       class="block text-sm font-medium text-slate-600 mb-2">
                    Пароль
                </label>

                <div class="relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                        <svg class="w-5 h-5 text-slate-400"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v2h8z">
                            </path>
                        </svg>
                    </div>

                    <input asp-for="Input.Password"
                           type="password"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Введите пароль"
                           class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 placeholder-slate-400 outline-none transition-all focus:bg-white focus:border-teal-400 focus:ring-2 focus:ring-teal-100" />
                </div>

                <span asp-validation-for="Input.Password"
                      class="block mt-1.5 text-sm text-rose-600">
                </span>
            </div>

            <!-- Запомнить меня -->
            <div class="flex items-center justify-between mb-6">
                <label asp-for="Input.RememberMe"
                       class="flex items-center gap-2 text-sm text-slate-600 cursor-pointer">
                    <input asp-for="Input.RememberMe"
                           class="w-4 h-4 rounded border-slate-300 text-teal-500 focus:ring-teal-400" />

                    <span>Запомнить меня</span>
                </label>

                <a id="forgot-password"
                   asp-page="./ForgotPassword"
                   class="text-sm font-medium text-teal-600 hover:text-teal-700 transition-colors">
                    Забыли пароль?
                </a>
            </div>

            <!-- Кнопка входа -->
            <button id="login-submit"
                    type="submit"
                    class="w-full py-3.5 bg-gradient-to-r from-teal-500 to-cyan-500 text-white rounded-xl font-semibold hover:from-teal-600 hover:to-cyan-600 transition-all shadow-lg shadow-teal-500/30 hover:shadow-teal-500/40 active:scale-[0.99]">
                Войти
            </button>

            <!-- Регистрация -->
            <div class="text-center mt-6 pt-6 border-t border-slate-100">
                <span class="text-sm text-slate-500">
                    Нет аккаунта?
                </span>

                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="text-sm font-semibold text-teal-600 hover:text-teal-700 transition-colors ml-1">
                    Зарегистрироваться
                </a>
            </div>

        </form>
    </div>

    <!-- Подсказка -->
    <p class="text-center text-xs text-slate-400 mt-6">
        Ваша домашняя аптечка всегда под рукой
    </p>

</div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}